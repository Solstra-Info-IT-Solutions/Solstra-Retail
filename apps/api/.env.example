NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/solstra_retail?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
CORS_ORIGIN=http://localhost:3000

# Optional isolated disaster-recovery restore target. MUST be a separate MongoDB host/deployment from MONGODB_URI.
DR_RESTORE_MONGO_URI=

# Optional signed operational alert receiver (HTTPS, public endpoint).
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=

# Optional vendor integration credentials. Presence does not authorize OAuth or certify connectivity.
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REDIRECT_URI=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
